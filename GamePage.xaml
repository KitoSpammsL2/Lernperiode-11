<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BlackJack.GamePage"
    BackgroundColor="#071C14"
    Shell.NavBarIsVisible="False">

    <Grid>

        <Border
            Margin="20"
            BackgroundColor="#0B3D2E"
            Stroke="#D4AF37"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 30">

            <ScrollView>

                <VerticalStackLayout
                    Padding="25"
                    Spacing="15">

                    <!-- DEALER -->

                    <Label
                        Text="DEALER"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="3"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="DealerScoreLabel"
                        Text="0"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout
                        x:Name="DealerCardsLayout"
                        HorizontalOptions="Center"
                        Spacing="8" />

                    <!-- MITTE -->

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Margin="0,20"
                        Spacing="4">

                        <Label
                            Text="BLACKJACK"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="#D4AF37"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="PAYS 3:2"
                            FontSize="11"
                            CharacterSpacing="3"
                            TextColor="#A8B9B0"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- PLAYER -->

                    <Label
                        Text="YOUR HAND"
                        FontSize="13"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="PlayerScoreLabel"
                        Text="0"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout
                        x:Name="PlayerCardsLayout"
                        HorizontalOptions="Center"
                        Spacing="8" />

                    <!-- STATUS -->

                    <Label
                        x:Name="GameStatusLabel"
                        Text="SET YOUR BET"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center"
                        Margin="0,15,0,5" />

                    <!-- GELD -->

                    <Label
                        x:Name="BalanceLabel"
                        Text="Balance: 1'000 Chips"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10">

                        <Entry
                            x:Name="BetEntry"
                            Text="100"
                            Placeholder="Einsatz"
                            Keyboard="Numeric"
                            WidthRequest="120"
                            TextColor="White"
                            PlaceholderColor="#A8B9B0"
                            HorizontalTextAlignment="Center" />

                        <Button
                            x:Name="DealButton"
                            Text="DEAL"
                            Clicked="OnDealClicked"
                            BackgroundColor="#D4AF37"
                            TextColor="#071C14"
                            FontAttributes="Bold"
                            WidthRequest="130"
                            CornerRadius="8" />

                    </HorizontalStackLayout>

                    <!-- HIT / STAND -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Margin="0,10,0,0">

                        <Button
                            x:Name="HitButton"
                            Grid.Column="0"
                            Text="HIT"
                            Clicked="OnHitClicked"
                            FontAttributes="Bold"
                            BackgroundColor="#D4AF37"
                            TextColor="#071C14"
                            HeightRequest="55"
                            CornerRadius="8"
                            IsEnabled="False" />

                        <Button
                            x:Name="StandButton"
                            Grid.Column="1"
                            Text="STAND"
                            Clicked="OnStandClicked"
                            FontAttributes="Bold"
                            BackgroundColor="#173F32"
                            BorderColor="#D4AF37"
                            BorderWidth="1"
                            TextColor="White"
                            HeightRequest="55"
                            CornerRadius="8"
                            IsEnabled="False" />

                    </Grid>

                </VerticalStackLayout>

            </ScrollView>

        </Border>

    </Grid>

</ContentPage>