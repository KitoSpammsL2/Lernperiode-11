<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BlackJack.MainPage"
    BackgroundColor="#071C14">

    <Grid Padding="30">

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="22">

            <!-- Karten Symbole -->
            <Label
                Text="♠  ♥  ♣  ♦"
                FontSize="36"
                TextColor="#D4AF37"
                HorizontalTextAlignment="Center" />

            <!-- Titel -->
            <Label
                Text="BLACKJACK"
                FontSize="42"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <Label
                Text="ROYALE"
                FontSize="22"
                CharacterSpacing="8"
                TextColor="#D4AF37"
                HorizontalTextAlignment="Center" />

            <!-- Dekoration -->
            <BoxView
                HeightRequest="1"
                WidthRequest="220"
                Color="#D4AF37"
                Margin="0,5,0,30" />

            <!-- Play Button -->
            <Button
                Text="PLAY"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#071C14"
                BackgroundColor="#D4AF37"
                WidthRequest="240"
                HeightRequest="60"
                CornerRadius="8"
                Clicked="OnPlayClicked" />

            <Label
                Text="BLACKJACK PAYS 3:2"
                FontSize="11"
                CharacterSpacing="2"
                TextColor="#80968C"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,0" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>